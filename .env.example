# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Caspian Email
CASPIAN_API_KEY=your_caspian_api_key_here
CASPIAN_BASE_URL=https://api.trycaspianai.com

# Web UI / 浏览器扩展鉴权：生产环境务必改成随机长串
# 生成：python -c "import secrets;print(secrets.token_hex(24))"
WEB_TOKEN=change-me-to-a-random-web-token
EXT_TOKEN=change-me-to-a-random-extension-token

# 网页搜索数据源（可选，按优先级自动降级）：
# TAVILY_API_KEY —— 推荐：AI Agent 专用搜索 API，免费额度 1000 次/月
#   注册 tavily.com（邮箱即可）→ 拿 key 填这里 → 重启生效
#   （大陆网络下 DDG 被墙、Bing 抓取会被软封锁，Tavily 是最稳的搜索源）
# BING_SEARCH_KEY —— Azure Bing Search v7（可选）
# TAVILY_API_KEY=
# BING_SEARCH_KEY=

# 本地默认只监听 127.0.0.1；容器/云平台再改 0.0.0.0
# HOST=127.0.0.1
# PORT=9866

# 每日定时情报推送时点（默认 08:30，可改）
# HERMES_DAILY_PUSH_HOUR=8
# HERMES_DAILY_PUSH_MIN=30

# 公网 Demo 提醒：关闭 execute_command / write_file 等高危工具，
# 或增加只读 Demo 模式，不要把完整本机操控能力暴露到公网。

